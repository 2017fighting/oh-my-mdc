      "css": ".ds-badge-danger{display:inline-flex;align-items:center;height:20px;padding:0 8px;border:1px solid var(--status-danger-border,oklch(0.885 0.062 18.334));border-radius:26px;background:var(--status-danger-surface,oklch(0.971 0.013 17.38));color:var(--status-danger-text,oklch(0.505 0.213 27.518));font:500 12px/1.33 \"Geist Variable\",\"PingFang SC\",\"Microsoft YaHei\",\"Noto Sans SC\",system-ui,sans-serif;white-space:nowrap}"
    },
    {
