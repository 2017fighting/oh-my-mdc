      "kind": "button",
      "refersTo": "button-primary",
      "description": "墨底纸字，每屏一个主操作：抽屉底部的「重试」。",
      "html": "<button class=\"ds-btn-primary\">重试</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 12px;border:1px solid transparent;border-radius:10px;background:var(--primary,oklch(0.205 0 0));color:var(--primary-foreground,oklch(0.985 0 0));font:500 14px/1.43 \"Geist Variable\",\"PingFang SC\",\"Microsoft YaHei\",\"Noto Sans SC\",system-ui,sans-serif;cursor:pointer;transition:background-color .15s cubic-bezier(.4,0,.2,1)}.ds-btn-primary:hover{background:color-mix(in oklab,var(--primary,oklch(0.205 0 0)) 80%,transparent)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring,oklch(0.55 0 0));outline-offset:2px}.ds-btn-primary:active{translate:0 1px}.ds-btn-primary:disabled{opacity:.5;pointer-events:none}"
    },
