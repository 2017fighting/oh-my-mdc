      "html": "<input class=\"ds-input\" placeholder=\"已保存：ab***yz\" />",
      "css": ".ds-input{height:32px;width:100%;box-sizing:border-box;padding:0 10px;border:1px solid var(--input,oklch(0.922 0 0));border-radius:10px;background:var(--background,oklch(1 0 0));color:var(--foreground,oklch(0.145 0 0));font:400 13px/1.5 \"Geist Variable\",\"PingFang SC\",\"Microsoft YaHei\",\"Noto Sans SC\",system-ui,sans-serif;outline:none}.ds-input::placeholder{color:var(--muted-foreground,oklch(0.5 0 0));font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.ds-input:focus-visible{border-color:var(--ring,oklch(0.55 0 0));box-shadow:0 0 0 2px var(--ring,oklch(0.55 0 0))}.ds-input:disabled{opacity:.6;cursor:not-allowed}"
